---
import type { HeroProps, SiteConfig } from "@types";
type Props = HeroProps & Pick<SiteConfig, "socialLinks">;

const { name, roles, summary, email, socialLinks } = Astro.props;

const GITHUB =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const LINKEDIN =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";

const href = (text: string) => socialLinks.find((l) => l.text === text)?.href;
const iconLinks = [
  { label: "LinkedIn", href: href("LinkedIn"), path: LINKEDIN },
  { label: "GitHub", href: href("Github"), path: GITHUB },
].filter((l) => l.href);
const cv = href("Download CV");
---

<section id="hero" class="relative pt-32 pb-16 md:pb-20">
  <h1
    class="reveal font-display text-6xl leading-[0.95] font-bold tracking-tighter sm:text-7xl md:text-8xl lg:text-9xl"
    style="--d:100ms"
  >
    Hi, I'm <br /><span class="grad-text">{name}</span>
  </h1>

  <p
    class="reveal mt-8 flex flex-wrap items-center gap-x-3 font-mono text-lg text-muted md:text-2xl"
    style="--d:200ms"
  >
    <span class="text-accent">&gt;</span>
    <span id="role" data-roles={JSON.stringify(roles)}>{roles[0]}</span><span
      class="-ml-2 inline-block h-6 w-0.5 animate-blink bg-accent"></span>
  </p>

  <p
    class="reveal mt-8 max-w-4xl text-lg leading-relaxed text-ink md:text-xl"
    style="--d:300ms"
  >
    {summary}
  </p>

  <div
    class="reveal mt-10 flex flex-wrap items-center gap-3 text-muted"
    style="--d:400ms"
  >
    <a href="#projects" class="btn btn-primary">View my work →</a>

    {
      iconLinks.map(({ label, href, path }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener"
          aria-label={label}
          title={label}
          class="grid size-11 place-items-center rounded-full border border-line transition hover:border-accent/50 hover:text-accent"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-5 fill-current"
            aria-hidden="true"
          >
            <path d={path} />
          </svg>
        </a>
      ))
    }
    <a
      href={`mailto:${email}`}
      aria-label="Email"
      title="Email"
      class="grid size-11 place-items-center rounded-full border border-line transition hover:border-accent/50 hover:text-accent"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5 fill-none stroke-current stroke-2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
    </a>
    {
      cv && (
        <a
          href={cv}
          target="_blank"
          rel="noopener"
          class="inline-flex h-11 items-center gap-2 rounded-full border border-line px-5 text-sm transition hover:border-accent/50 hover:text-accent"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-4 fill-none stroke-current stroke-2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" />
          </svg>
          Download CV
        </a>
      )
    }
  </div>
</section>
<script>
  const el = document.querySelector<HTMLElement>("#role");
  if (el && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? "[]");
    let r = 0;
    let c = roles[0].length;
    let deleting = true;
    const tick = () => {
      const word = roles[r];
      c += deleting ? -1 : 1;
      el.textContent = word.slice(0, c);
      let delay = deleting ? 40 : 80;
      if (!deleting && c === word.length) {
        deleting = true;
        delay = 1800;
      } else if (deleting && c === 0) {
        deleting = false;
        r = (r + 1) % roles.length;
      }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 2000);
  }
</script>
