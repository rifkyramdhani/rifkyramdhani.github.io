---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="relative py-16 md:py-20">
  <div class="reveal mb-12 md:mb-16">
    <p class="eyebrow mb-3">// {eyebrow}</p>
    <h2 class="font-display text-4xl font-bold tracking-tight md:text-5xl">
      {title}
    </h2>
  </div>
  <slot />
</section>
